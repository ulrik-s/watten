{
  "name": "watten-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir frontend/pkg",
    "build:wasm:test": "wasm-pack build --target nodejs --out-dir pkg-test --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit -p tsconfig.build.json && vite build",
    "serve": "vite preview",
    "test": "npm run build:wasm:test && vitest run",
    "test:watch": "vitest",
    "test:full": "npm run build:wasm:test && CARGO_MANIFEST_PATH=../Cargo.toml cargo full && vitest run",
    "coverage": "npm run build:wasm:test && vitest run --coverage",
    "test:e2e": "NO_PROXY=localhost,127.0.0.1 npm run build && NO_PROXY=localhost,127.0.0.1 playwright test"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.0"
  }
}
